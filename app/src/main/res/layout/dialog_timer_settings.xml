<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/dialog_timer_settings.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121826">

    <!-- Work duration -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WORK DURATION"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:letterSpacing="0.12"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <SeekBar
            android:id="@+id/sbWorkDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="#4CAF50"
            android:thumbTint="#4CAF50"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvWorkValue"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="25 min"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="end"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1 min ←————————————→ 60 min"
        android:textSize="10sp"
        android:textColor="#3D5060"
        android:layout_marginBottom="20dp"/>

    <!-- Break duration -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BREAK DURATION"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:letterSpacing="0.12"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <SeekBar
            android:id="@+id/sbBreakDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="#2196F3"
            android:thumbTint="#2196F3"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvBreakValue"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="5 min"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="end"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1 min ←————————————→ 60 min"
        android:textSize="10sp"
        android:textColor="#3D5060"
        android:layout_marginBottom="24dp"/>

    <!-- Live preview -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#0D1520">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREVIEW"
                android:textSize="9sp"
                android:textColor="#3D5060"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSettingsPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Work 25 min → Break 5 min"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>