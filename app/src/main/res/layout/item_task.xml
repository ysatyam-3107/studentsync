<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_task.xml -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#161F2C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Priority dot -->
        <View
            android:id="@+id/priorityDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/priority_dot_bg"
            android:backgroundTint="#FF9800"/>

        <!-- Checkbox -->
        <CheckBox
            android:id="@+id/cbTaskComplete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:buttonTint="#4CAF50"/>

        <!-- Text block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title row: title + overdue badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTaskTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <!-- 🔴 Overdue badge -->
                <TextView
                    android:id="@+id/tvOverdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OVERDUE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/overdue_badge_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Optional note -->
            <TextView
                android:id="@+id/tvTaskNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#506070"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>

            <!-- Date row: created + due -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/tvTaskDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#3D5060"/>

                <TextView
                    android:id="@+id/tvDueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#90CAF9"
                    android:layout_marginStart="10dp"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Delete button -->
        <ImageButton
            android:id="@+id/btnDeleteTask"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_delete"
            android:background="@drawable/btn_delete_bg"
            android:padding="8dp"
            app:tint="#EF5350"
            android:contentDescription="Delete task"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>